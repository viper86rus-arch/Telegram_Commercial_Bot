# Пример файла конфигурации. Скопируйте его в .env и укажите свои данные:
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
ADMIN_CHAT_ID=YOUR_TELEGRAM_NUMERIC_ID
DB_PATH=leads.db
SELLER_NAME=YOUR_FULL_NAME
SELLER_INN=YOUR_12_DIGIT_INN
BANK_NAME=YOUR_BANK_NAME
BANK_BIK=000000000
BANK_CORR=30101810000000000000
BANK_ACCOUNT=40817810000000000000
PAYMENT_SBP=YOUR_SBP_PHONE
# Токен провайдера Telegram Payments (ЮKassa/Сбербанк через @BotFather). Оставьте пустым для встроенного демо-эквайринга:
PAYMENT_PROVIDER_TOKEN=
